# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# DATABASE CONFIGURATION (SQLite by default, MySQL / MariaDB optional)
# ============================================================================
# By default, Binesh uses a persistent relational SQLite database at ./data/binesh.db
# To switch to MySQL / MariaDB on your server, set DB_ENGINE="mysql" and fill in:
DB_ENGINE="sqlite"
SQLITE_PATH="./data/binesh.db"

MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE="binesh_db"

# ============================================================================
# ADMIN & AUTH SECURITY
# ============================================================================
AUTH_SECRET="binesh-secret-token-key-change-in-production"
ADMIN_DEFAULT_EMAIL="admin@binesh.ir"
ADMIN_DEFAULT_PHONE="09164006698"
ADMIN_DEFAULT_PASSWORD="Binesh@1404"

# ============================================================================
# INSTANT NOTIFICATION CHANNELS (Configurable here or inside the Admin Panel)
# ============================================================================
# 1. SMTP Email Notification
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@binesh.ir"
NOTIFY_ADMIN_EMAIL="binesh.office@gmail.com"

# 2. Iranian SMS Gateway (kavenegar | melipayamak)
SMS_PROVIDER="kavenegar"
NOTIFY_ADMIN_PHONE="09164006698"

# Kavenegar API Key & Optional Sender/Template
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
KAVENEGAR_TEMPLATE=""

# MeliPayamak Credentials
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""
